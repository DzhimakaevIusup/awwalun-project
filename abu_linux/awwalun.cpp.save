#include <iostream>
#include <string>

void printCrescent() {
    std::cout << "\n";
    std::cout << "          _..._          \n";
    std::cout << "        .'     '.        \n";
    std::cout << "       /  0  0   \\       \n";
    std::cout << "      |           |      \n";
    std::cout << "      |           |      \n";
    std::cout << "       \\        /       \n";
    std::cout << "        '.     .'        \n";
    std::cout << "          '---'          \n";
    std::cout << "       (Полумесяц)       \n";
    std::cout << "\n";
}

int main() {
    std::string answer;
    std::string name;
    
    std::cout << "أهلاً وسهلاً! (Добро пожаловать!)\n";
    std::cout << "Как тебя зовут? ";
    std::getline(std::cin, name);
    
    std::cout << "\n" << name << ", ты мусульманин? (да / нет): ";
    std::getline(std::cin, answer);

    std::cout << "\n------------------------------------------------\n";
    
    if (answer == "да" || answer == "Да" || answer == "YES") {
        std::cout << "ما شاء الله! (МашаАллах!)\n";
        std::cout << "Пусть твой путь будет светлым, а знания — глубокими.\n";
    } else {
        std::cout << "Мир тебе и твоему дому!\n";
        std::cout << "В исламе ценят добро и уважение. Если захочешь узнать больше о религии — всегда интересно узнать что-то новое.\n";
    }

    std::cout << "Вот тебе символ мира и света:\n";
    printCrescent();

    std::cout << "\nУдачи в учебе и программировании!\n";
    return 0;
}
